{
  "name": "circuit",
  "version": "0.1.0",
  "private": true,
  "description": "Une voiture sur un circuit en simulation : la trajectoire, la vitesse que l'adhérence permet, et le pilote qui cherche le meilleur temps au tour.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=93 --test-coverage-branches=90 --test-coverage-functions=90",
    "tracks": "node scripts/download-tracks.js",
    "references": "node scripts/references.js",
    "bench": "node scripts/profile-bench.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc -p .",
    "check": "npm run lint && npm run types && npm test",
    "prepare": "git config core.hooksPath .githooks",
    "search-bench": "node scripts/search-bench.js",
    "lines": "node scripts/lines.js",
    "page": "node node_modules/mcts-commun/bin/serve.js 4809",
    "changelog": "node scripts/changelog.js",
    "drive": "node scripts/drive.js"
  },
  "author": "Sami",
  "license": "UNLICENSED",
  "dependencies": {
    "mcts-commun": "file:../mcts-commun"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "typescript": "^5.9.3"
  }
}
